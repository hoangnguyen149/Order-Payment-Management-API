{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*",
  "Jwt": { "Issuer": "OrderPayment", "Audience": "OrderPayment.Client", "LifetimeMinutes": 30 },
  "Auth": { "AdminUsername": "admin", "StaffUsername": "staff" },
  "Database": { "MigrateOnStartup": false },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "Gateway": { "BaseUrl": "http://localhost:8090" },
  "Marketplace": { "BaseUrl": "http://localhost:8090" },
  "Jobs": { "Enabled": true, "PollSeconds": 30, "PendingPaymentMinutes": 2, "MarketplaceIntervalSeconds": 120 },
  "RateLimiting": { "GlobalPermitLimit": 120 }
}
